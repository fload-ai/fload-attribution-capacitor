{
  "name": "@fload-ai/attribution-capacitor",
  "version": "1.0.0",
  "description": "Fload install attribution for Capacitor apps (Apple Ads via AdServices, Google Play Install Referrer)",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Vendor",
    "Package.swift",
    "FloadAiAttributionCapacitor.podspec"
  ],
  "author": "Fload Technologies Limited",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fload-ai/fload-attribution-capacitor.git"
  },
  "bugs": {
    "url": "https://github.com/fload-ai/fload-attribution-capacitor/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "attribution",
    "apple ads",
    "adservices",
    "install referrer",
    "fload"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme FloadAiAttributionCapacitor -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "docgen": "docgen --api FloadAttributionPlugin --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run test:ios-host && npm run test:android",
    "test:ios-host": "sh scripts/host-test-ios.sh",
    "test:android": "cd android && ./gradlew test && cd ..",
    "stub-ingest": "node scripts/stub-ingest.mjs --port 3999",
    "check:ios-simulator": "sh scripts/ios-simulator-check.sh",
    "vendor": "node scripts/vendor-ios-sdk.mjs package ios/Vendor/FloadAttribution",
    "check:vendor": "node scripts/vendor-ios-sdk.mjs package ios/Vendor/FloadAttribution --check"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "homepage": "https://github.com/fload-ai/fload-attribution-capacitor#readme",
  "floadNative": {
    "ios": "1.1.0",
    "android": "1.1.0"
  }
}
